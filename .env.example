# Postgres connection (docker compose up -d db gives you this one)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/testmgmt"

# Auth.js: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="change-me"

# Sign-in providers. Since version 92 a workspace admin sets up Microsoft, Google
# or company SSO in Workspace settings → Sign-in instead. Values here still work
# and win over that page. Leave a pair empty to hide that button.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Who may sign in: people already invited to a project, the very first user,
# and anyone whose email ends in one of these domains (comma separated).
AUTH_ALLOWED_DOMAINS=""

