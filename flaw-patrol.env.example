# Settings for the hosted Flaw Patrol (docker-compose.hosting.yml).
# Copy to flaw-patrol.env ON THE SERVER ONLY and fill it in. Never commit it, zip it or email it.

# Password for the Flaw Patrol database container. Letters and numbers only, so it
# can sit in the address below as is. Make one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# How Flaw Patrol reaches that database: put the same password after "flawpatrol:".
DATABASE_URL=postgresql://flawpatrol:PASSWORD-FROM-ABOVE@db:5432/flawpatrol

# The same AUTH_SECRET as your other Flaw Patrol copies, so saved Jira tokens keep working.
# New team? Make one with: openssl rand -base64 32
AUTH_SECRET=

# Optional: anyone with an email at these domains may sign in (comma separated).
AUTH_ALLOWED_DOMAINS=

# Optional: how many database connections Flaw Patrol keeps open (default 10), so the
# update helper's backup and IT's tools always find a free one. A number from 1 to 100.
# DATABASE_POOL=10
