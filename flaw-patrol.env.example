# Settings for the hosted Flaw Patrol (docker-compose.hosting.yml).
# Copy to flaw-patrol.env ON THE SERVER ONLY and fill it in. Never commit it, zip it or email it.

# Postgres connection string, for example from Neon (Dashboard > Connect).
# Either address works; database changes always go through the direct one.
DATABASE_URL=

# The same AUTH_SECRET as your other Flaw Patrol copies, so saved Jira tokens keep working.
# New team? Make one with: openssl rand -base64 32
AUTH_SECRET=

# Optional: anyone with an email at these domains may sign in (comma separated).
AUTH_ALLOWED_DOMAINS=
