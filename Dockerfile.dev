# Local trial image for `docker compose up`: runs the app in development mode
# (slower, detailed error pages). Not for hosting; the production image is Dockerfile.
FROM node:22
WORKDIR /app
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000
CMD ["sh", "-c", "npx prisma migrate deploy && if [ \"$SEED_DEMO\" = \"true\" ]; then npm run db:seed; fi && npx next dev -H 0.0.0.0 -p 3000"]
